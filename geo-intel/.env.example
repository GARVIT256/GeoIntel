# ============================================================
# GEO-INTEL – environment variables template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- LLM provider (choose one; others can be left blank) ---
LLM_PROVIDER=openai          # openai | gemini | anthropic | ollama | mock
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434

# --- STAC endpoints (public, no key needed, but override if you have a PC token) ---
PC_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
AWS_STAC_URL=https://earth-search.aws.element84.com/v1
PC_SDK_SUBSCRIPTION_KEY=          # optional: Planetary Computer subscription key

# --- PostGIS (matches docker-compose.yml defaults) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geointel
POSTGRES_USER=geointel
POSTGRES_PASSWORD=changeme

# --- Misc ---
LOG_LEVEL=INFO
RANDOM_SEED=42
